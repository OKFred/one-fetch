{
  "name": "one-fetch",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A transparent, self-hosted multi-runtime request relay for xPanel.",
  "license": "MIT",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24.20.0 <27"
  },
  "scripts": {
    "acceptance:gateway": "pnpm --filter @one-fetch/conformance build && node tools/acceptance/run-gateway-conformance.mjs",
    "build": "pnpm -r --if-present build",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm check:openapi && pnpm check:security",
    "check:openapi": "node tools/release/generate-openapi.mjs --check",
    "check:security": "node tools/release/check-import-boundaries.mjs && node tools/release/check-dependency-policy.mjs && node tools/release/check-source-size.mjs",
    "dev:admin": "pnpm --filter @one-fetch/admin dev",
    "dev:node": "pnpm --filter @one-fetch/adapter-node dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "generate:openapi": "node tools/release/generate-openapi.mjs",
    "lint": "eslint .",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck",
    "release:artifacts": "node tools/release/build-review-bundle.mjs",
    "release:finalize": "node tools/release/finalize-review-bundle.mjs",
    "release:verify": "node tools/release/verify-release-input.mjs",
    "test:release": "node --test tools/release/*.test.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.1",
    "@eslint/js": "9.35.0",
    "@types/node": "24.3.1",
    "eslint": "9.35.0",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.6.2",
    "tsx": "4.23.13",
    "typescript": "5.9.2",
    "typescript-eslint": "8.69.0",
    "vitest": "4.1.11"
  }
}
