ONE_FETCH_INSTANCE_ID=one-fetch-node
ONE_FETCH_CONTROL_HOST=127.0.0.1
ONE_FETCH_CONTROL_PORT=8787
ONE_FETCH_GATEWAY_HOST=127.0.0.1
ONE_FETCH_GATEWAY_PORT=8788
ONE_FETCH_PUBLIC_CONTROL_URL=http://127.0.0.1:8787
ONE_FETCH_PUBLIC_GATEWAY_URL=http://127.0.0.1:8788
ONE_FETCH_CONTROL_ALLOWED_ORIGINS=http://127.0.0.1:4173
ONE_FETCH_DATABASE_PATH=./data/one-fetch.sqlite
# Optional non-interactive destination; creation fails if the file exists.
# ONE_FETCH_BOOTSTRAP_TOKEN_FILE=./data/bootstrap-token
# Generate all secrets locally. Never commit real values.
ONE_FETCH_INSTANCE_PEPPER=replace-with-at-least-32-random-characters
ONE_FETCH_PROTOCOL_SIGNING_KEY=replace-with-at-least-32-random-characters
# Base64-encoded Ed25519 PKCS#8 DER private key.
ONE_FETCH_AUDIT_SIGNING_PRIVATE_KEY=replace-with-generated-private-key-base64
