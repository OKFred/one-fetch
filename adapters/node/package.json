{
  "name": "@one-fetch/adapter-node",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.20.0 <27"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "bin": {
    "one-fetch": "./dist/cli.js"
  },
  "scripts": {
    "build": "pnpm run migrations:check && tsc -b",
    "clean": "node --input-type=module -e \"import('node:fs').then(({rmSync})=>rmSync('dist',{recursive:true,force:true}))\"",
    "start": "node dist/cli.js",
    "dev": "tsx src/cli.ts",
    "migrations:check": "node scripts/migration-integrity.mjs --check",
    "migrations:generate": "node scripts/migration-integrity.mjs --write",
    "migrations:test": "node --test scripts/migration-integrity.test.mjs",
    "test": "pnpm run migrations:check && pnpm run migrations:test && tsc -b && vitest run --config vitest.config.ts",
    "typecheck": "pnpm run migrations:check && tsc -b --pretty false"
  },
  "dependencies": {
    "@hono/node-server": "2.1.1",
    "@hono/zod-openapi": "1.6.2",
    "@one-fetch/core": "workspace:*",
    "@one-fetch/protocol": "workspace:*",
    "bcryptjs": "3.0.3",
    "hono": "4.13.5",
    "ws": "8.21.3",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@one-fetch/client": "workspace:*",
    "@one-fetch/conformance": "workspace:*",
    "@types/node": "26.4.1",
    "@types/ws": "8.18.1",
    "tsx": "4.23.13",
    "typescript": "5.9.2",
    "vitest": "4.1.11"
  }
}
