# Generated independently for every deployment. Never commit real values.
ONE_FETCH_INSTANCE_ID=00000000-0000-4000-8000-000000000001
ONE_FETCH_BOOTSTRAP_SECRET=replace-with-at-least-32-random-bytes
ONE_FETCH_PEPPER=replace-with-at-least-32-random-bytes
ONE_FETCH_AUDIT_SIGNING_PRIVATE_KEY=base64url-pkcs8-ed25519-private-key
ONE_FETCH_AUDIT_KEY_ID=audit-2026-09
ONE_FETCH_ALLOWED_ADMIN_ORIGINS=http://localhost:5173
ONE_FETCH_ALLOWED_CLIENT_ORIGINS=chrome-extension://aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
ONE_FETCH_CONTROL_BASE_URL=http://127.0.0.1:54321/functions/v1/one-fetch-control
ONE_FETCH_GATEWAY_BASE_URL=http://127.0.0.1:54321/functions/v1/one-fetch-gateway
# Applied deployments inject ONE_FETCH_BUILD_VERSION from the exact Git commit.
# Local development falls back to 0.1.0-preview when it is unset.

# Supabase injects these in hosted and local Edge Functions.
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
